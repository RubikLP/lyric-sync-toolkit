# Copy this to ".env" in the same folder as docker-compose.yml (or fill
# these in directly in Unraid's Compose Manager "env file" tab).

# Path to your music library on the host (read+write - the toolkit tags,
# renames, and deletes .lrc/.txt files inside it).
MUSIC_PATH=/mnt/user/data/media/music

# Path where settings.json and generated reports are kept, so they
# survive container rebuilds.
APPDATA_PATH=/mnt/user/appdata/lrc-tool

# Port the web UI is exposed on.
WEBUI_PORT=8420
